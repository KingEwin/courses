# Niveau 1 — Naïf
# Tout en vrac, base lourde, ordre quelconque
# Taille attendue : ~1.1 - 1.5 Go

FROM node:20

WORKDIR /app

# COPY tout d'un coup → cache cassé au moindre changement
COPY . .

# npm install (au lieu de npm ci) + devDeps embarquées en prod
RUN npm install
RUN npm run build

EXPOSE 3000

CMD ["node", "dist/server.js"]
