// CineTrack — schema Prisma
// SQLite local, multi-utilisateur. Migrations versionnées dans prisma/migrations/.
// Le catalogue Film est partagé ; chaque utilisateur a ses propres Reviews
// (statut + note + commentaire) sur les films qui l'intéressent.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  displayName  String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reviews      Review[]
}

model Film {
  id        String   @id @default(cuid())
  title     String
  year      Int?
  director  String?
  synopsis  String?
  posterUrl String?
  tmdbId    Int?     @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews   Review[]

  @@index([title])
}

/// Statuts autorisés : "TO_WATCH" | "WATCHING" | "WATCHED"
/// (SQLite ne supporte pas les enums natifs ; contraint au niveau TS via FilmStatus)
model Review {
  id        String   @id @default(cuid())
  userId    String
  filmId    String
  status    String   @default("TO_WATCH")
  rating    Int? // 0..10 (null = pas noté)
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  film      Film     @relation(fields: [filmId], references: [id], onDelete: Cascade)

  @@unique([userId, filmId])
  @@index([userId])
  @@index([filmId])
  @@index([status])
}
